# 复制为 .env 后填写。不要把 .env 发给别人或提交到 Git。
SIS_USERNAME=
SIS_PASSWORD=

# 默认按你说的目标填写。若页面只把 T23 显示为可独立判断的班级，可改成 T23。
COURSE_QUERY=GEA
SECTION_TOKENS=L09,T23
MATCH_MODE=all

# 推荐 60 秒；脚本不允许低于 30 秒，避免给学校系统造成压力。
CHECK_INTERVAL_SECONDS=60

# 三选一即可。推荐永久免费、无需实名认证付费的 WxPusher 极简推送。
WXPUSHER_SPT=
PUSHPLUS_TOKEN=
SERVERCHAN_SENDKEY=

# 第一次 setup 必须显示浏览器；之后可按需要改为 true。
HEADLESS=false
STOP_AFTER_NOTIFY=false

# 一般不用改。
SIS_URL=https://sis.cuhk.edu.cn/
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
